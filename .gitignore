# The compiled frontend, copied here by scripts/build_web_static.sh from web/out/.
# It is build output, not source: everything in it comes from web/ plus web/public/,
# and scripts/start_dataman_services.sh rebuilds it on every start (skip with
# DATAMAN_SKIP_WEB_BUILD=1). Not tracked, so a fresh clone has to build it once
# before the backend can start -- mount_static_files() mounts this directory with
# StaticFiles, which raises if it is missing.
/packages/dbgpt-app/src/dbgpt_app/static/web/

# production
/web/build

