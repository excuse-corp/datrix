# Archived upstream DB-GPT material. The smaller legacy scripts stay tracked;
# old Docker deployment files are excluded separately below.
/legacy/docs/
# The upstream example scripts. Note that examples/awel/ was loaded at runtime as
# the default AWEL DAG directory (`_DAG_DEFINITION_DIR`), so archiving it removes
# the /api/v1/awel/trigger/examples/* endpoints; the loader skips a missing
# directory silently.
/legacy/examples/

# Legacy DB-GPT Docker deployment files. The Datrix app has no Docker image;
# Docker remains in use for PostgreSQL and optional sandbox containers.
/.dockerignore
/docker-compose.yml
/legacy/docker/
