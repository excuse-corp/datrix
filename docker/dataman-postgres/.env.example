# Copy this file to .env before deploying. It is intentionally ignored by Git.
DATAMAN_POSTGRES_DB=dataman_data
DATAMAN_POSTGRES_USER=dataman_admin
DATAMAN_POSTGRES_PASSWORD=replace-with-a-long-random-admin-password
DATAMAN_SYNC_PASSWORD=replace-with-a-long-random-sync-password
DATAMAN_READER_PASSWORD=replace-with-a-long-random-reader-password

# Bind to loopback by default. Set to a private server address only when the
# third-party synchronization platform runs on another trusted machine.
DATAMAN_POSTGRES_BIND_ADDRESS=127.0.0.1
DATAMAN_POSTGRES_PORT=54329
