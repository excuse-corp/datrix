# Local-only credentials for the Chengqin Indicator Hub Skill.
# Copy the values into .env.dataman.local; do not commit that local file.
CHENGQIN_METRIC_BASE_URL=https://指标中枢域名
CHENGQIN_METRIC_APPKEY=
CHENGQIN_METRIC_SECRET=
# Optional fixed service account. Prefer mapping the current Datrix user when possible.
CHENGQIN_METRIC_USERNAME=
# The PDF examples use pageNum; set pageNo only if the target server requires it.
CHENGQIN_METRIC_PAGE_FIELD=pageNum
CHENGQIN_METRIC_TIMEOUT=20
