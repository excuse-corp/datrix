# Copy to .env.ask-data locally and keep the local file out of version control.
# Do not commit production credentials.

DBGPT_LANG=zh
DBGPT_ENCRYPT_KEY=replace-with-a-long-random-value

# Model provider (choose one provider in the Datrix profile config).
LLM_MODEL_NAME=Qwen/Qwen2.5-Coder-32B-Instruct
LLM_MODEL_PROVIDER=proxy/siliconflow
EMBEDDING_MODEL_NAME=BAAI/bge-large-zh-v1.5
EMBEDDING_MODEL_PROVIDER=proxy/openai
EMBEDDING_MODEL_API_URL=https://api.siliconflow.cn/v1/embeddings
SILICONFLOW_API_KEY=

# Local DataMan PostgreSQL read-only connection. Copy the reader password from
# docker/dataman-postgres/.env after deployment; never commit the real value.
DATAMAN_DATA_DB_HOST=127.0.0.1
DATAMAN_DATA_DB_PORT=54329
DATAMAN_DATA_DB_NAME=dataman_data
DATAMAN_DATA_DB_USER=dataman_reader
DATAMAN_DATA_DB_PASSWORD=

# Local Datrix paths.
DBGPT_KNOWLEDGE_ROOT=pilot/data
DBGPT_METADATA_DB=sqlite:///pilot/meta_data/dbgpt.db

# Local account authentication. Set a random secret with at least 32 characters.
DBGPT_AUTH_SECRET=
DBGPT_AUTH_DB=sqlite:///pilot/meta_data/dbgpt_auth.db
DBGPT_AUTH_REQUIRED=true
DBGPT_AUTH_MODE=hybrid
DBGPT_AUTH_TOKEN_TTL=600
DBGPT_AUTH_REFRESH_TOKEN_TTL=28800
DBGPT_AUTH_SESSION_IDLE_TIMEOUT=3600
DBGPT_AUTH_ISSUER=dataman
DBGPT_AUTH_AUDIENCE=dataman-api
DBGPT_AUTH_COOKIE_SECURE=true
# Enable CAS only when both values are configured with production HTTPS URLs.
DBGPT_AUTH_CAS_PROVIDER_ID=cas
DBGPT_AUTH_CAS_BASE_URL=
DBGPT_AUTH_CAS_CALLBACK_URL=
DBGPT_AUTH_CAS_SUBJECT_CANDIDATES=ID_NUMBER,user
DBGPT_AUTH_CAS_USERNAME_ATTRIBUTE=ID_NUMBER
DBGPT_AUTH_CAS_DISPLAY_NAME_ATTRIBUTE=USER_NAME
DBGPT_AUTH_CAS_VERIFY_TLS=true
# Optional first administrator; remove these values after bootstrapping.
DBGPT_AUTH_BOOTSTRAP_USERNAME=
DBGPT_AUTH_BOOTSTRAP_PASSWORD=

# Enable the AskData tool inside the original React chat agent. Set false to
# immediately fall back to the legacy generic-chat tool set.
DBGPT_REACT_ASK_DATA_TOOL_ENABLED=true
